 .../auth-profiles.external-cli-sync.test.ts   | 85 ++++++++++++++++++-
 src/agents/auth-profiles/external-cli-sync.ts | 56 +++++++++++-
 2 files changed, 138 insertions(+), 3 deletions(-)

